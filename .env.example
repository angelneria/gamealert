# ============================================
# GameAlert - Environment Variables
# ============================================

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
# Local: SQLite en fichero (solo desarrollo — NUNCA persiste en Vercel)
DATABASE_URL="file:./dev.db"
# Producción (Vercel): Turso (SQLite remoto, plan gratis)
#   1. Crea la base: turso db create gamealert
#   2. Pega aquí su URL y el token (turso db show gamealert --url / turso db tokens create gamealert)
#DATABASE_URL="libsql://gamealert-xxx.turso.io"
#TURSO_AUTH_TOKEN=tu_token_de_turso

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP (alternative for email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# APIs
RAWG_API_KEY=your_rawg_api_key_here
EPIC_GAMES_API_KEY=your_epic_games_api_key_here
STEAM_API_KEY=your_steam_api_key_here
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this
# Sesiones firmadas (cookie ga_session) — openssl rand -hex 32
SESSION_SECRET=
# Protege /api/cron/notify (Vercel Cron envía `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=

# Scraper
SCRAPE_INTERVAL_MINUTES=60
NOTIFICATION_COOLDOWN_HOURS=24

# Game Filtering Thresholds
MIN_STEAM_REVIEWS=5000
MIN_METACRITIC_SCORE=60
MIN_CONCURRENT_PLAYERS=5000
WHITELIST_PUBLISHERS=Valve,Rockstar,Epic Games,Bethesda,Capcom,Electronic Arts,Activision,Blizzard,Naughty Dog,Sony,Microsoft,Riot Games,Bungie,EA Sports,Tencent,Ubisoft,2K,Sega,Warner Bros

# Chollos (juegos rebajados) — defaults para usuarios nuevos
DEALS_DEFAULT_MAX_PRICE=10
DEALS_DEFAULT_MIN_DISCOUNT=75
DEALS_MAX_PRICE_CAP=30

# Notification Channels
ENABLE_EMAIL=true
ENABLE_DISCORD=false
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ID=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900
