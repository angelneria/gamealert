{
  "name": "gamealert",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:turso": "tsx scripts/db-push-turso.ts",
    "queue": "tsx src/server/queue-worker.ts",
    "scrape": "tsx src/server/scraper-runner.ts",
    "notify": "tsx src/server/notify-runner.ts",
    "notify:loop": "tsx src/server/notify-loop.ts",
    "notify:reset": "tsx src/server/notify-runner.ts --reset",
    "notify:list": "tsx src/server/notify-runner.ts --list",
    "test": "./scripts/test.sh",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev:docker": "docker compose up -d && npm run db:migrate && npm run dev",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.2",
    "bullmq": "^5.11.0",
    "cheerio": "^1.2.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "next": "^14.2.0",
    "next-auth": "^4.24.7",
    "nodemailer": "^10.0.14",
    "prisma": "^5.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
